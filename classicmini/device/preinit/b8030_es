es_dir=/var/lib/hakchi/emulationstation

if [ -f "$es_dir/es-run.sh" ] && [ ! -f /run/es-stock ] && [ ! -f "$es_dir/no_boot" ] && [ "$(cat "$es_dir/boot_default" 2>/dev/null)" != stock ]; then
  stockUistart() {
    rm -f /var/lib/clover/autotest
    uistop
    if [ -f "$squashfs/usr/game/m2engage" ]; then
      sh "/etc/init.d/S99first_startup" start
    else
      sh "/etc/init.d/S81clover-mcp" start
    fi
  }

  uistart() {
    [ -n "$ES_GAME" ] && return 0
    uistop
    for _ in $(seq 1 10); do
      kill -0 "$(cat /run/es-run.pid 2>/dev/null)" 2>/dev/null || break
      usleep 300000
    done
    start-stop-daemon -S -b -q -m -p /run/es-run.pid -x /bin/sh -- "$es_dir/es-run.sh"
  }
fi
