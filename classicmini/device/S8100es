es_dir=/var/lib/hakchi/emulationstation
autotest=/var/lib/clover/autotest
case "$1" in
  start)
    rm -f "$autotest"
    [ -f "$es_dir/no_boot" ] && exit 0
    [ "$(cat "$es_dir/boot_default" 2>/dev/null)" = stock ] && exit 0
    for _ in $(seq 1 5); do
      pad_status=0
      "$es_dir/padstate" select || pad_status=$?
      [ "$pad_status" -eq 0 ] && { touch /run/es-stock; exit 0; }
      [ "$pad_status" -eq 1 ] && break
      usleep 200000
    done
    touch "$autotest"
    if start-stop-daemon -S -b -q -m -p /run/es-run.pid -x /bin/sh -- "$es_dir/es-run.sh"; then
      ( sleep 10; rm -f "$autotest" ) &
    else
      rm -f "$autotest"
    fi
  ;;
  stop)
    [ -z "$(pidof clover-mcp)" ] || exit 0
    es_run_pid=$(cat /run/es-run.pid 2>/dev/null)
    { [ -n "$es_run_pid" ] && grep -q es-run.sh "/proc/$es_run_pid/cmdline" 2>/dev/null; } || [ -n "$(pidof emulationstation)" ] || exit 0
    touch /tmp/es-stopping
    start-stop-daemon -K -q -p /run/es-run.pid
    killall emulationstation 2>/dev/null
    usleep 300000
    splash=shutdown
    [ -f /tmp/es-restarting ] && splash=restart
    decodepng "$es_dir/resources/$splash.png" > /dev/fb0
  ;;
esac
